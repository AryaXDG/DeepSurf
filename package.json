{
  "name": "deepsurf-history-manager",
  "displayName": "DeepSurf History Manager",
  "version": "0.1.0",
  "description": "Your private AI browsing companion. Map ideas on a visual canvas, track habits securely, and chat with your history offline.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "zip": "node scripts/package.js",
    "release": "pnpm build && pnpm zip"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@mlc-ai/web-llm": "^0.2.46",
    "@xenova/transformers": "^2.17.2",
    "chart.js": "^4.5.1",
    "chartjs-chart-matrix": "^3.0.4",
    "chartjs-chart-treemap": "^3.1.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "adm-zip": "^0.5.17",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "puppeteer": "^24.42.0",
    "shelljs": "^0.10.0",
    "svelte-preprocess": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.21"
  },
  "manifest": {
    "host_permissions": [
      "<all_urls>"
    ],
    "permissions": [
      "storage",
      "unlimitedStorage",
      "sidePanel",
      "offscreen",
      "tabs",
      "history",
      "webNavigation",
      "alarms"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    }
  }
}